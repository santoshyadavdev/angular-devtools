{
  "name": "@santoshyadavdev/ng-devtools",
  "version": "0.0.1",
  "description": "Angular DevTools — inspect components, signals, DI, and routes. Runs standalone, embedded, or over MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santoshyadavdev/angular-devtools.git",
    "directory": "packages/ng-devtools"
  },
  "homepage": "https://github.com/santoshyadavdev/angular-devtools#readme",
  "type": "module",
  "bin": {
    "ng-devtools": "./bin.mjs"
  },
  "exports": {
    ".": "./src/devframe.ts",
    "./devframe": "./src/devframe.ts",
    "./overlay": "./src/overlay.ts",
    "./popup": "./src/popup.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/devframe.mjs",
      "./devframe": "./dist/devframe.mjs",
      "./overlay": "./dist/overlay.mjs",
      "./popup": "./dist/popup.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown && vite build --config ../../app/vite.config.ts --outDir ../packages/ng-devtools/dist/public --emptyOutDir",
    "prepack": "pnpm build"
  },
  "files": [
    "dist",
    "bin.mjs"
  ],
  "keywords": [
    "angular",
    "devtools",
    "devframe",
    "signals",
    "dependency-injection",
    "mcp"
  ],
  "dependencies": {
    "@devframes/agentic": "^1.0.0",
    "@valibot/to-json-schema": "^1.8.0",
    "cac": "^7.0.0",
    "devframe": "^1.0.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.0"
  },
  "engines": {
    "node": ">=22"
  }
}
